{
  "schema": 1,
  "id": "file-manager",
  "dart": {
    "package": "aqutter_plugin_file_manager",
    "class": "FileManagerPlugin"
  },
  "native": {
    "features": {
      "sandbox": {},
      "granted": {},
      "pick": {
        "note": "macOS 沙盒 App 需要 entitlement com.apple.security.files.user-selected.read-only 才能讀取使用者選的檔案"
      },
      "gallery": {
        "android": {
          "permissions": [
            { "name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 28 }
          ]
        },
        "ios": {
          "infoPlist": {
            "NSPhotoLibraryAddUsageDescription": "Save images to your photo library"
          }
        }
      },
      "downloads": {}
    }
  }
}
